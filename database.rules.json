{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('host').val() === auth.uid && newData.child('status').val() === 'lobby' && newData.child('players').child(auth.uid).exists() && newData.child('mode').val() === 'levels' && newData.child('questionIds').numChildren() === 15 && newData.child('players').numChildren() === 1",
        ".validate": "newData.hasChildren(['host', 'status', 'mode', 'currentQuestion', 'questionIds', 'questionStartedAt', 'players', 'revealedQuestion', 'createdAt']) && newData.child('currentQuestion').val() >= 0 && newData.child('currentQuestion').val() < 15 && newData.child('players').numChildren() <= 2",
        "host": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
          ".validate": "newData.isString()"
        },
        "status": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('host').val() === auth.uid && ((data.val() === 'lobby' && newData.val() === 'playing' && root.child('rooms').child($roomId).child('players').numChildren() === 2) || ((data.val() === 'lobby' || data.val() === 'playing') && newData.val() === 'finished'))",
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|playing|finished)$/)"
        },
        "mode": {
          ".write": "auth != null && !data.exists() && root.child('rooms').child($roomId).child('host').val() === auth.uid",
          ".validate": "newData.val() === 'levels'"
        },
        "currentQuestion": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('host').val() === auth.uid && root.child('rooms').child($roomId).child('status').val() === 'playing' && newData.val() === data.val() + 1 && newData.val() < 15",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 15"
        },
        "questionIds": {
          ".write": "auth != null && !data.exists() && root.child('rooms').child($roomId).child('host').val() === auth.uid",
          ".validate": "newData.hasChildren() && newData.numChildren() === 15",
          "$index": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 15"
          }
        },
        "questionStartedAt": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('host').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "revealedQuestion": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('host').val() === auth.uid && root.child('rooms').child($roomId).child('status').val() === 'playing' && newData.val() === root.child('rooms').child($roomId).child('currentQuestion').val()",
          ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() < 15"
        },
        "createdAt": {
          ".write": "auth != null && !data.exists() && root.child('rooms').child($roomId).child('host').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && ((!newData.exists()) || (root.child('rooms').child($roomId).child('status').val() === 'lobby' && (root.child('rooms').child($roomId).child('players').numChildren() < 2 || data.exists())))",
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 24 && newData.child('joinedAt').isNumber()"
          }
        },
        "answers": {
          "$uid": {
            "$questionIndex": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('players').child($uid).exists() && root.child('rooms').child($roomId).child('status').val() === 'playing' && root.child('rooms').child($roomId).child('currentQuestion').val() === $questionIndex * 1 && !data.exists()",
              ".validate": "newData.hasChildren(['choice', 'submittedAt']) && newData.child('choice').isNumber() && newData.child('choice').val() >= 0 && newData.child('choice').val() <= 3 && newData.child('submittedAt').isNumber()"
            }
          }
        }
      }
    }
  }
}
